# CoreGo environment template.
# Copy to .env and uncomment what you need. Every variable is optional;
# the full reference is docs/environment.md. Never commit your real .env.
# Variables set in the process environment always win over this file.

# --- Application ---------------------------------------------------------------
# Port the HTTP server listens on (default 8080).
PORT=8080
# Public base URL used in email links (default http://localhost:$PORT).
# An https:// URL also marks the session cookie Secure.
# APP_URL=https://api.example.com

# --- Databases (the facade connects automatically when set) --------------------
# MongoDB connection string.
# MONGODB_CONNECTION_URL=mongodb://localhost:27017
# MongoDB database name (default: the name in the URL path, else "corego").
# MONGODB_DATABASE=myapp
# PostgreSQL connection string.
# POSTGRES_CONNECTION_URL=postgres://user:password@localhost:5432/myapp

# --- Auth ------------------------------------------------------------------------
# Auth store: memory, mongo or postgres (empty = first connected database,
# MongoDB then PostgreSQL, else memory with a warning).
# COREGO_AUTH_STORE=postgres
# Prefix of the auth tables / collections (default corego_; lowercase, digits, _).
# COREGO_AUTH_TABLE_PREFIX=myapp_auth_
# true: users must verify their email address before signing in. Turns the
# setting on even when the code leaves it off (code OR environment).
# COREGO_REQUIRE_VERIFIED_EMAIL=true
# true: sign-up and sign-in also set the HttpOnly session cookie (code OR environment).
# COREGO_AUTH_COOKIE=true
# Frontend page linked from password reset emails (default $APP_URL/reset-password).
# COREGO_RESET_PASSWORD_URL=https://app.example.com/reset-password
# Where the email verification link redirects with ?status=verified|invalid|expired
# (empty = a minimal built-in HTML page).
# COREGO_VERIFY_EMAIL_REDIRECT_URL=https://app.example.com/email-verified

# --- Mail ----------------------------------------------------------------------
# How auth emails are delivered when no mailer is set in code:
#   (empty) SMTP when SMTP_HOST is set, otherwise none with a warning
#   smtp    SMTP; startup fails when SMTP_HOST is missing (good for production)
#   log     development only: emails and their live links go to the log
#   none    no emails, no warning
# COREGO_MAIL=log
# SMTP server; when set, verification and password reset emails are sent.
# SMTP_HOST=smtp.example.com
# SMTP port (default 587). 465 uses implicit TLS, every other port STARTTLS.
# SMTP_PORT=587
# SMTP login (empty = no authentication).
# SMTP_USERNAME=no-reply@example.com
# SMTP password (for Gmail: an app password, not your account password).
# SMTP_PASSWORD=change-me
# Sender address, optionally with a display name.
# SMTP_FROM="My App <no-reply@example.com>"

# --- HTTP server -----------------------------------------------------------------
# Comma separated browser origins allowed to call the API (empty = CORS off).
# Listed origins may send cookies; "*" allows every origin but without cookies.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.example.com
# true only behind a reverse proxy you control (client IP from X-Forwarded-For).
# TRUST_PROXY_HEADERS=false
# Startup banner of core.Run (services and routes). Empty = only in a terminal.
# COREGO_BANNER=true
# Any value turns off the colors of the banner and of the console logs.
# NO_COLOR=1
